{
  "name": "munim-pencilkit",
  "version": "1.17.1",
  "description": "React Native PencilKit and Apple Pencil (Pro) for iOS/iPadOS, built with Nitro Modules",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p example",
    "lint": "eslint .",
    "test": "jest",
    "clean": "git clean -dfX",
    "release": "semantic-release",
    "build": "npm run typecheck && bob build",
    "codegen": "nitrogen --logLevel=\"debug\" && npm run build",
    "postcodegen": "npm --prefix example run pod",
    "release:local": "node scripts/release-local.mjs"
  },
  "keywords": [
    "react-native",
    "munim-pencilkit",
    "pencilkit",
    "apple-pencil",
    "apple-pencil-pro",
    "drawing",
    "nitro"
  ],
  "files": [
    "src",
    "lib",
    "nitrogen",
    "nitro.json",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.swift",
    "*.podspec",
    "README.md"
  ],
  "workspaces": [
    "example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munimtechnologies/munim-pencilkit.git"
  },
  "author": "sheehanmunim",
  "license": "Apache-2.0",
  "bugs": "https://github.com/munimtechnologies/munim-pencilkit/issues",
  "homepage": "https://github.com/munimtechnologies/munim-pencilkit#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/js": "^10.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "babel-jest": "^30.5.2",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "nitrogen": "0.37.2",
    "prettier": "^3.10.1",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-nitro-modules": "0.37.2",
    "semantic-release": "^26.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.36.5 <1"
  },
  "overrides": {
    "brace-expansion@1.x": "1.1.21",
    "brace-expansion@2.x": "2.1.7",
    "brace-expansion@>=4 <6": "5.0.12",
    "joi@17.x": "17.13.8",
    "js-yaml@3.x": "3.15.2",
    "js-yaml@4.x": "4.3.2",
    "ip-address@10.x": "10.7.3",
    "undici@7.x": "7.30.0",
    "@semantic-release/npm": {
      "npm": "npm:@semantic-release/error@4.0.0"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/__tests__"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/__tests__/__mocks__/react-native.ts",
      "^react-native-nitro-modules$": "<rootDir>/__tests__/__mocks__/react-native-nitro-modules.ts"
    },
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            "module:@react-native/babel-preset"
          ]
        }
      ]
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__mocks__/"
    ]
  }
}
